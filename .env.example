# Copy to .env and adjust to your local setup (see README.md "Local Setup").
DATABASE_URL=postgres://nextvisit:CHANGE_ME@localhost:5432/nextvisit
TEST_DATABASE_URL=postgres://nextvisit:CHANGE_ME@localhost:5432/nextvisit_test
PORT=3000
AUTH_TOKEN_SECRET=CHANGE_ME
# Bearer token the GitHub Actions reminder workflow sends to /api/reminders
# (Authorization header). Must match the REMINDERS_SECRET set on Vercel.
REMINDERS_SECRET=
# Public URL of the web app, used to build the one-time link in emails.
APP_URL=http://localhost:5173
# Resend transactional email API key (confirmation, reminder, notices).
# Optional locally: when unset, emails are skipped with a warning.
RESEND_API_KEY=
# Sender address. Defaults to the clinic domain (verify it in Resend).
# For local testing without DNS, use the Resend sandbox: "Next Visit <onboarding@resend.dev>"
# (delivers only to the account owner's email).
RESEND_FROM=