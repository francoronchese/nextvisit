# Copy to .env and adjust to your local setup (see README.md "Local Setup").
DATABASE_URL=postgres://nextvisit:CHANGE_ME@localhost:5432/nextvisit
TEST_DATABASE_URL=postgres://nextvisit:CHANGE_ME@localhost:5432/nextvisit_test
PORT=3000
AUTH_TOKEN_SECRET=CHANGE_ME
# Production requires at least 32 random characters (e.g. `openssl rand -base64 32`).
# Bearer token the GitHub Actions scheduler workflows send to /api/reminders
# and /api/no-shows (Authorization header). Must match the REMINDERS_SECRET
# set on Vercel.
REMINDERS_SECRET=
# Public URL of the web app, used to build the one-time link in emails.
APP_URL=http://localhost:5173
# Resend transactional email API key (confirmation, reminder, notices).
# Optional locally: when unset, emails are skipped with a warning.
RESEND_API_KEY=
# Sender address. Defaults to the clinic domain (verify it in Resend).
# For local testing without DNS, use the Resend sandbox: "Next Visit <onboarding@resend.dev>"
# (delivers only to the account owner's email).
RESEND_FROM=
# Comma-separated allowlist of client origins allowed to call this API
# cross-origin (Vercel SPA + API on different origins). Unset = same-origin only.
CLIENT_ORIGIN=http://localhost:5173
# Max failed staff logins per email+IP inside the window before 429. Default: 5.
MAX_LOGIN_ATTEMPTS=5
# Required (set to "yes") for `pnpm db:seed` to run against a database with
# NODE_ENV=production, because the seed wipes appointments and patients.
SEED_ALLOW_DATA_LOSS=